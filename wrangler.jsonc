{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "op-reconnect",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-04",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/share/*"],
    "not_found_handling": "404-page"
  }
}
